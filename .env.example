# Copiez ce fichier en .env et renseignez vos valeurs.

# auto : Neon si la base répond, sinon stockage local (démo) | neon | local
NUXT_PUBLIC_DATA_MODE=auto
NUXT_PUBLIC_DEMO_MODE=true
NUXT_PUBLIC_APP_NAME=EcoBloc

# Neon (Postgres)
DATABASE_URL=

# Neon Auth
NUXT_PUBLIC_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecobloc
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_FOLDER=ecobloc
